rules_version = '2';

// Paste into Firebase console > Firestore Database > Rules, then Publish.
// Do this again every time this file changes.
service cloud.firestore {
  match /databases/{database}/documents {
    // A player's save. Only that signed-in player can read or change it.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // A 1 vs 1 match, found by its code. Any signed-in player can look one
    // up and take part. The player who created it stays its owner, and only
    // they can close it.
    match /matches/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
          && request.resource.data.host.uid == request.auth.uid;
      allow update: if request.auth != null
          && request.resource.data.host.uid == resource.data.host.uid;
      allow delete: if request.auth != null
          && resource.data.host.uid == request.auth.uid;
    }
  }
}
